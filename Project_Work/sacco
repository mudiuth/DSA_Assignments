#include <stdio.h>
#include <stdlib.h>
#include <time.h>

#define TABLE_SIZE 10  // Modulus: 10 Farmers can use it safely

// Structure for a single deposit
typedef struct Deposit {
    int farmerID;
    double amount;
    time_t timestamp;
    struct Deposit* next;
