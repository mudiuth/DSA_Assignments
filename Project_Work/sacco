## **4️⃣ Modify the `main()` Function**
We now **allow user interaction** using a **menu-based system**.

```c
int main() {
    initFarmerTable();  // Initialize farmer storage

    int choice, farmerID;
    char name[50], pin[5];

    while (1) {
        printf("\n==== SACCO MANAGEMENT ====\n");
        printf("1. Register Farmer\n");
        printf("2. List Farmers\n");
        printf("3. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                printf("Enter Farmer ID: ");
                scanf("%d", &farmerID);
                printf("Enter Farmer Name: ");
                scanf(" %[^\n]", name);  // Read full name
                printf("Set 4-digit PIN: ");
                scanf("%4s", pin);
                registerFarmer(farmerID, name, pin);
                break;

            case 2:
                listFarmers();
                break;

            case 3:
                printf("Exiting system...\n");
                return 0;

            default:
                printf("Invalid choice! Try again.\n");
        }
    }

    return 0;
}
```

