} Farmer;

// Hash table for transactions and PINs
Transaction* transactionTable[TABLE_SIZE];
Farmer* pinTable[TABLE_SIZE];

// Function to initialize hash tables
void initTables() {
    for (int i = 0; i < TABLE_SIZE; i++) {
        transactionTable[i] = NULL;
        pinTable[i] = NULL;
    }
