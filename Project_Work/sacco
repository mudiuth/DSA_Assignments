// Function to save account statement to a file
void exportStatementToFile(int farmerID) {
    int index = hashFunction(farmerID);
    Transaction* temp = hashTable[index];

    // File name format: "Statement_Farmer101.txt"
    char fileName[30];
    sprintf(fileName, "Statement_Farmer%d.txt", farmerID);

    FILE *file = fopen(fileName, "w"); // Open file in write mode
    if (!file) {
        printf("Error creating statement file!\n");
        return;
    }

    fprintf(file, "========== ACCOUNT STATEMENT ==========\n");
    fprintf(file, "Farmer ID: %d\n", farmerID);
    fprintf(file, "----------------------------------------\n");

    if (temp == NULL) {
        fprintf(file, "No transactions found for this account.\n");
        fclose(file);
        printf("Statement exported: %s\n", fileName);
        return;
    }

    while (temp != NULL) {
        fprintf(file, "%-12s | Amount: %.2f | Date: %s", temp->type, temp->amount, ctime(&temp->timestamp));
        temp = temp->next;
    }

    fprintf(file, "----------------------------------------\n");
    fprintf(file, "Current Balance: %.2f\n", getBalance(farmerID));
    fprintf(file, "========================================\n");

    fclose(file); // Close the file
    printf("Statement exported successfully: %s\n", fileName);
}
```

